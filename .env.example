# Optional: raises GitHub quota and enables the contribution heatmap
GITHUB_TOKEN=
# Optional: enable the "Analyze developer" AI report (either key is enough)
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=
# auto | gemini | groq
AI_PROVIDER=
# Used by docker compose for the local PostgreSQL container
POSTGRES_PASSWORD=
# Backend only: comma-separated frontend origins allowed by CORS when the
# frontend is hosted separately (e.g. Vercel). Not needed with docker compose.
CORS_ALLOWED_ORIGINS=
